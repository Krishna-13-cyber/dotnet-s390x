#!/bin/bash
set -e -u -x -o pipefail

BASEDIR=$(cd "$(dirname "$0")" && pwd)
HIGHER_BAND_VERSION=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --higher-band)
            HIGHER_BAND_VERSION="$2"
            shift 2
            ;;
        *)
            echo "Unknown argument: $1" >&2
            exit 1
            ;;
    esac
done

filter=()
if git -C "$(dirname "$0")" fetch --filter=tree:0 >/dev/null 2>&1; then
    filter=(--filter=tree:0)
fi

function cherry_pick {
    local commitid="$1"

    if git cherry-pick -X theirs "$commitid"; then
        return
    fi

    if [ "$commitid" = "e64f84d" ]; then
        local patchfile="src/source-build-assets/src/externalPackages/patches/azure-activedirectory-identitymodel-extensions-for-dotnet/0002-Fix-assembly-version-calculation-in-2026.patch"

        if git diff --name-only --diff-filter=U | grep -qx "$patchfile"; then
            git add "$patchfile"
            GIT_EDITOR=true git cherry-pick --continue
            return
        fi
    fi

}

function backport {
    # Commit that introduced the bug, or an empty string.
    fixes=$1
    # Commit or patch that fixes the bug, optionally followed by backported or
    # conflicting commits.
    commitids=$2
    if [ -n "$fixes" ] && ! git merge-base --is-ancestor "$fixes" HEAD; then
        return
    fi
    for commitid in $commitids; do
        if [ -e "$commitid" ]; then
            continue
        fi
        if git merge-base --is-ancestor "$commitid" HEAD; then
            return
        fi
    done
    for commitid in $commitids; do
        if [ -e "$commitid" ]; then
            git am "$commitid"
        else
            cherry_pick "$commitid"
        fi
        break
    done
}

function prepare_sdk {
    pushd dotnet
    if [[ -s ../dotnet-patches/series ]] &&
        ! git merge-base --is-ancestor "49278fa" HEAD; then
        rm -rf .pc
        ln -fsT ../dotnet-patches patches
        quilt push -a
    else
        git fetch origin main
        backport "" e64f84d
        backport 58d1b48 eb2c106
        if git merge-base --is-ancestor e020f45 HEAD; then
            if ! git merge-base --is-ancestor 5fbaa71 HEAD; then
                git am "$BASEDIR/dotnet-patches/5fbaa71-streamline-arch-arg.patch"
            fi
        fi
    fi
    popd
}
projects=(dotnet)
if [[ -n "$HIGHER_BAND_VERSION" ]]; then
    # Higher-band path (2xx/3xx/4xx): remove whatever dotnet/ contains
    # (submodule gitlink after dotnet-bump, stale clone, or nothing) and
    # do a fresh shallow clone at the band tag.
    # No patches needed — higher-band tags contain all fixes upstream.
    TAG="v${HIGHER_BAND_VERSION}"
    DOTNETDIR="$BASEDIR/dotnet"
    rm -rf "${DOTNETDIR}"
    git clone --depth 1 --branch "${TAG}" \
        "https://github.com/dotnet/dotnet.git" "${DOTNETDIR}"
else
    # Normal 1xx path — completely unchanged.
    git submodule update "${filter[@]}" --init --recursive -- "${projects[@]}"
    eval prepare_sdk
fi
